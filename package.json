    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.2",
    "three-stdlib": "^2.34.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@gltf-transform/core": "^4.0.7",
